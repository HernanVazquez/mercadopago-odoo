<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mercadopago_point_order_company_rule" model="ir.rule">
        <field name="name">Mercado Pago Point Orders: allowed companies</field>
        <field name="model_id" ref="model_mercadopago_point_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="mercadopago_point_config_company_rule" model="ir.rule">
        <field name="name">Mercado Pago Point configurations: allowed companies</field>
        <field name="model_id" ref="model_mercadopago_point_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
