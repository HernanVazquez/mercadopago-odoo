<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mercadopago_point_config_tree" model="ir.ui.view">
        <field name="name">mercadopago.point.config.tree</field>
        <field name="model">mercadopago.point.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="environment"/>
                <field name="integration_type"/>
                <field name="terminal_id" optional="show"/>
                <field name="external_pos_id" optional="show"/>
                <field name="timeout_seconds"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mercadopago_point_config_form" model="ir.ui.view">
        <field name="name">mercadopago.point.config.form</field>
        <field name="model">mercadopago.point.config</field>
        <field name="arch" type="xml">
            <form string="Mercado Pago Orders Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="integration_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="terminal_id"
                                   attrs="{'invisible': [('integration_type', '!=', 'point')], 'required': [('integration_type', '=', 'point')]}"/>
                            <field name="external_pos_id"
                                   attrs="{'invisible': [('integration_type', '!=', 'qr')], 'required': [('integration_type', '=', 'qr')]}"/>
                            <field name="qr_mode"
                                   attrs="{'invisible': [('integration_type', '!=', 'qr')], 'required': [('integration_type', '=', 'qr')]}"/>
                            <field name="access_token" password="True" groups="base.group_system"/>
                            <field name="timeout_seconds"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mercadopago_point_config" model="ir.actions.act_window">
        <field name="name">Mercado Pago Orders</field>
        <field name="res_model">mercadopago.point.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_environment': 'test'}</field>
    </record>

    <menuitem id="menu_mercadopago_point_config"
              name="Mercado Pago Orders"
              parent="account.menu_finance_configuration"
              action="action_mercadopago_point_config"
              sequence="90"
              groups="base.group_system"/>

    <record id="action_mercadopago_production_audit" model="ir.actions.act_window">
        <field name="name">Production Status History</field>
        <field name="res_model">mercadopago.production.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <menuitem id="menu_mercadopago_production_audit"
              name="Production Status History"
              parent="account.menu_finance_configuration"
              action="action_mercadopago_production_audit"
              sequence="91"
              groups="base.group_system"/>
</odoo>
